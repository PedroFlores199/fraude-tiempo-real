          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT fecha AS time, transacciones_por_segundo AS \"TPS\" FROM metricas WHERE $__timeFilter(fecha) ORDER BY 1"
