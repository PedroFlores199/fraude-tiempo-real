{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fraude-tiempo-real/esquema/transaccion.json",
  "title": "Transacción con tarjeta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id_transaccion",
    "cliente_id",
    "tarjeta_id",
    "importe",
    "moneda",
    "comercio",
    "categoria",
    "canal",
    "ciudad",
    "lat",
    "lon",
    "fecha_hora"
  ],
  "properties": {
    "id_transaccion": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "cliente_id": {
      "type": "string",
      "pattern": "^CLI-[0-9]{5}$"
    },
    "tarjeta_id": {
      "type": "string",
      "pattern": "^TAR-[0-9a-f]{12}$"
    },
    "importe": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100000
    },
    "moneda": {
      "type": "string",
      "enum": ["EUR"]
    },
    "comercio": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "categoria": {
      "type": "string",
      "enum": [
        "alimentacion",
        "restauracion",
        "transporte",
        "electronica",
        "moda",
        "ocio",
        "salud",
        "hogar",
        "viajes",
        "suministros",
        "joyeria",
        "apuestas"
      ]
    },
    "canal": {
      "type": "string",
      "enum": ["presencial", "online"]
    },
    "ciudad": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "fecha_hora": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
