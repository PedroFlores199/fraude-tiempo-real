{
  "title": "Perfil de cliente",
  "type": "object",
  "required": [
    "_id",
    "tipo",
    "ciudad",
    "ubicacion",
    "tarjetas",
    "comercios_frecuentes",
    "categorias",
    "horario_tipico",
    "fecha_alta"
  ],
  "properties": {
    "_id": {"type": "string", "pattern": "^CLI-[0-9]{5}$"},
    "tipo": {"enum": ["particular", "empresa"]},
    "ciudad": {"type": "string", "minLength": 1},
    "ubicacion": {
      "type": "object",
      "required": ["lat", "lon"],
      "properties": {
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lon": {"type": "number", "minimum": -180, "maximum": 180}
      }
    },
    "tarjetas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tarjeta_id", "tipo", "activa"],
        "properties": {
          "tarjeta_id": {"type": "string", "pattern": "^TAR-[0-9a-f]{12}$"},
          "tipo": {"enum": ["debito", "credito", "empresa"]},
          "activa": {"type": "boolean"},
          "limite_mensual": {"type": "number", "minimum": 0}
        }
      }
    },
    "comercios_frecuentes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "categorias": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["gasto_medio", "compras_mes"],
        "properties": {
          "gasto_medio": {"type": "number", "minimum": 0.01},
          "compras_mes": {"type": "number", "minimum": 0}
        }
      }
    },
    "horario_tipico": {
      "type": "object",
      "required": ["inicio", "fin"],
      "properties": {
        "inicio": {"type": "number", "minimum": 0, "maximum": 23},
        "fin": {"type": "number", "minimum": 1, "maximum": 24}
      }
    },
    "fecha_alta": {"bsonType": "date"}
  },
  "oneOf": [
    {
      "properties": {
        "tipo": {"enum": ["particular"]},
        "nombre": {"type": "string", "minLength": 1},
        "apellidos": {"type": "string", "minLength": 1},
        "edad": {"type": "number", "minimum": 18, "maximum": 120},
        "ocupacion": {"type": "string"}
      },
      "required": ["nombre", "apellidos", "edad", "ocupacion"]
    },
    {
      "properties": {
        "tipo": {"enum": ["empresa"]},
        "razon_social": {"type": "string", "minLength": 1},
        "cif": {"type": "string", "pattern": "^[A-HJ-NP-SUVW][0-9]{7}[0-9A-J]$"},
        "sector": {"type": "string"},
        "num_empleados": {"type": "number", "minimum": 1},
        "persona_contacto": {"type": "string"}
      },
      "required": ["razon_social", "cif", "sector", "num_empleados"]
    }
  ]
}
